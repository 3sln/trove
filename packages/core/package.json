{
  "name": "@trove/core",
  "version": "0.0.1",
  "type": "module",
  "description": "Runtime-agnostic core for Trove: pluggable storage, metadata, resumable transfers, semantic search, and indexers.",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./errors.js": "./src/errors.js",
    "./retry.js": "./src/retry.js",
    "./util.js": "./src/util.js",
    "./storage/*": "./src/storage/*",
    "./metadata/*": "./src/metadata/*",
    "./search/*": "./src/search/*",
    "./indexers/*": "./src/indexers/*",
    "./plugins/*": "./src/plugins/*"
  },
  "files": [
    "src/"
  ],
  "dependencies": {
    "fflate": "^0.8.3"
  },
  "license": "MIT",
  "author": "Ray Stubbs"
}
