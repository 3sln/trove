# Copy to .env and adjust. All optional — defaults are in-memory (zero config).

# ── Storage backend ───────────────────────────────────────────────
TROVE_STORAGE=filesystem            # memory | filesystem | s3
TROVE_FS_ROOT=./data/objects        # filesystem/NAS root (a mount point works)

# S3-compatible (AWS S3, Cloudflare R2, MinIO, Backblaze B2):
# TROVE_STORAGE=s3
# TROVE_S3_BUCKET=my-bucket
# TROVE_S3_REGION=us-east-1          # "auto" for R2
# TROVE_S3_ENDPOINT=                 # e.g. https://<acct>.r2.cloudflarestorage.com (omit for AWS)
# TROVE_S3_ACCESS_KEY_ID=
# TROVE_S3_SECRET_ACCESS_KEY=
# TROVE_S3_PATH_STYLE=false          # true for MinIO / custom endpoints

# ── Metadata store (file tree + per-indexer facets) ───────────────
TROVE_METADATA=sqlite               # memory | sqlite
TROVE_DB_PATH=./data/trove.db

# ── Semantic search embeddings (optional) ─────────────────────────
# Leave unset to use the built-in offline hash embedding.
# TROVE_EMBEDDINGS_URL=https://api.openai.com/v1/embeddings
# TROVE_EMBEDDINGS_API_KEY=
# TROVE_EMBEDDINGS_MODEL=text-embedding-3-small
# TROVE_EMBEDDINGS_DIM=1536

# ── Vector store (pluggable) ──────────────────────────────────────
TROVE_VECTOR=memory                 # memory | qdrant
# TROVE_VECTOR=qdrant
# TROVE_QDRANT_URL=http://localhost:6333
# TROVE_QDRANT_COLLECTION=trove
# TROVE_QDRANT_API_KEY=
# TROVE_QDRANT_DISTANCE=Cosine       # Cosine | Dot | Euclid

# ── Server ────────────────────────────────────────────────────────
PORT=8787
HOST=0.0.0.0
