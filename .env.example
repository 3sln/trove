# Copy to .env and adjust. All optional — defaults are in-memory (zero config).

# ── Storage backend ───────────────────────────────────────────────
TROVE_STORAGE=filesystem            # memory | filesystem | s3
TROVE_FS_ROOT=./data/objects        # filesystem/NAS root (a mount point works)

# S3-compatible (AWS S3, Cloudflare R2, MinIO, Backblaze B2):
# TROVE_STORAGE=s3
# TROVE_S3_BUCKET=my-bucket
# TROVE_S3_REGION=us-east-1          # "auto" for R2
# TROVE_S3_ENDPOINT=                 # e.g. https://<acct>.r2.cloudflarestorage.com (omit for AWS)
# TROVE_S3_ACCESS_KEY_ID=
# TROVE_S3_SECRET_ACCESS_KEY=
# TROVE_S3_PATH_STYLE=false          # true for MinIO / custom endpoints

# ── Metadata store (file tree + per-indexer facets) ───────────────
TROVE_METADATA=sqlite               # memory | sqlite
TROVE_DB_PATH=./data/trove.db

# ── Semantic search embeddings (optional) ─────────────────────────
# Leave unset to use the built-in offline hash embedding.
# TROVE_EMBEDDINGS_URL=https://api.openai.com/v1/embeddings
# TROVE_EMBEDDINGS_API_KEY=
# TROVE_EMBEDDINGS_MODEL=text-embedding-3-small
# TROVE_EMBEDDINGS_DIM=1536

# ── Vector store (pluggable) ──────────────────────────────────────
TROVE_VECTOR=memory                 # memory | qdrant | vectorize
# Qdrant:
# TROVE_VECTOR=qdrant
# TROVE_QDRANT_URL=http://localhost:6333
# TROVE_QDRANT_COLLECTION=trove
# TROVE_QDRANT_API_KEY=
# TROVE_QDRANT_DISTANCE=Cosine       # Cosine | Dot | Euclid
# Cloudflare Vectorize (REST; on Workers the VECTORIZE binding is auto-detected):
# TROVE_VECTOR=vectorize
# TROVE_VECTORIZE_ACCOUNT_ID=
# TROVE_VECTORIZE_API_TOKEN=
# TROVE_VECTORIZE_INDEX=trove

# ── Identity (bring your own IdP — Trove ships no login) ──────────
# WARNING: 'anonymous' + the open default collection = anyone who can reach the
# port has full read/write/delete access. Fine on localhost; before exposing this
# server, set an IdP AND TROVE_AUTH_REQUIRED=true (and/or TROVE_DEFAULT_OPEN=false),
# and run it behind an authenticating reverse proxy over TLS.
TROVE_AUTH=anonymous                # anonymous | jwt | header
# Cloudflare Access / Zero Trust (verify JWT via JWKS):
# TROVE_AUTH=jwt
# TROVE_JWKS_URL=https://<team>.cloudflareaccess.com/cdn-cgi/access/certs
# TROVE_JWT_ISSUER=https://<team>.cloudflareaccess.com
# TROVE_JWT_AUDIENCE=<access-application-aud>
# TROVE_AUTH_REQUIRED=true           # reject unauthenticated requests (don't fall back to anonymous)
# TROVE_JWT_SECRET=                  # HS256 shared secret — DEV ONLY; prefer JWKS in production
# Or trust a header a verifying proxy already set:
# TROVE_AUTH=header
# TROVE_AUTH_ID_HEADER=cf-access-authenticated-user-email

# ── Access control ────────────────────────────────────────────────
# TROVE_DEFAULT_OPEN=false           # don't grant everyone all caps on the 'default' collection
# TROVE_ADMINS=you@example.com       # comma-separated principal ids with admin
# TROVE_COLLECTION_CREATOR_ROLES=    # roles allowed to create collections

# ── Hardening ─────────────────────────────────────────────────────
# TROVE_CORS_ORIGIN=                 # off by default (same-origin). '*' or an origin allowlist
# TROVE_CSP=                         # app-shell Content-Security-Policy (opt-in; see SAMPLE_CSP).
#                                    # Off by default — sandboxed plugin iframes can't satisfy a strict one.
# TROVE_MAX_JSON_BYTES=4194304       # cap on JSON request bodies
# TROVE_MAX_PAGE=1000                # cap on list/search result limits

# ── Web push (VAPID) for @mention notifications ───────────────────
# Generate keys once:
#   node -e "import('@trove/core').then(async m=>console.log(await m.generateVapidKeys()))"
# TROVE_VAPID_PUBLIC_KEY=
# TROVE_VAPID_PRIVATE_KEY=
# TROVE_VAPID_SUBJECT=mailto:admin@example.com
# TROVE_MENTION_FLUSH_MS=30000

# ── Server ────────────────────────────────────────────────────────
PORT=8787
HOST=0.0.0.0
