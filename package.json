{
  "name": "trove",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Trove \u2014 a self-hostable, plugin-extensible Google Drive. Semantic search, pluggable storage (S3 / filesystem / NAS), and a VS Code-style contribution system with sandboxed plugins.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "cd packages/web && npm run dev",
    "build:web": "cd packages/web && npm run build",
    "serve": "bun packages/server/src/adapters/bun.js",
    "serve:node": "node packages/server/src/adapters/node.js",
    "test": "bun test",
    "backup": "bun scripts/backup.mjs"
  },
  "engines": {
    "node": ">=20",
    "bun": ">=1.1.0"
  },
  "license": "MIT",
  "author": "Ray Stubbs",
  "devDependencies": {
    "aws4": "^1.13.2",
    "playwright-core": "^1.61.1",
    "s3rver": "^3.7.1"
  }
}
