{
  "name": "trove",
  "version": "0.0.1",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "trove",
      "version": "0.0.1",
      "license": "MIT",
      "workspaces": [
        "packages/*"
      ],
      "engines": {
        "bun": ">=1.1.0",
        "node": ">=20"
      }
    },
    "node_modules/@trove/core": {
      "resolved": "packages/core",
      "link": true
    },
    "node_modules/@trove/server": {
      "resolved": "packages/server",
      "link": true
    },
    "packages/core": {
      "name": "@trove/core",
      "version": "0.0.1",
      "license": "MIT"
    },
    "packages/server": {
      "name": "@trove/server",
      "version": "0.0.1",
      "license": "MIT",
      "dependencies": {
        "@trove/core": "0.0.1"
      }
    }
  }
}
